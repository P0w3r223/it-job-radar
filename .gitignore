# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# Data artifacts (collected offers, snapshots) — dir kept via .gitkeep
data/raw/*
!data/raw/.gitkeep

# SQLite database (generated by the collector)
*.db
*.sqlite
*.sqlite3

# Generated Pages report. `pipeline site --out build/site` and the CI drift job both write
# here; the published page is the copy in docs/, which IS committed.
build/

# IDE / editor
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Lokalny indeks CodeGraph (graf kodu per maszyna, odbudowywalny przez `codegraph init`)
.codegraph/
# Added by code-review-graph
.code-review-graph/

# Local database backups. The published dataset lives in docs/data/ and IS committed —
# it is the artifact the site downloads (ADR 0001).
data/backups/

# Claude Code, per machine. Not `.claude/` wholesale: `settings.json` is reviewable
# configuration and belongs to whoever checks this repository out, while the paths below
# never do. Left untracked and unignored, the first permission grant on any other checkout
# makes `git status` report a change that is not one — a standing false finding in the one
# instrument whose whole value is that a finding means something.
.claude/sessions/
.claude/settings.local.json
# Throwaway checkouts an assistant subagent runs in: whole copies of this repository, so
# committing one would nest the tree inside itself.
.claude/worktrees/
